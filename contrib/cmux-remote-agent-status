#!/bin/bash
# Report a remote chat's state to cmux, from inside the cmux terminal that shows it.
#
#   cmux-remote-agent-status <remote-host> [interval-seconds]
#
# cmux drives its sidebar from hooks that run beside the agent, and it accepts them only over a
# socket connection from a process it started itself. A chat on another machine therefore cannot
# report for itself: whatever it sends arrives from outside and is refused. What it can do is answer
# questions, so this runs in the surface's own shell, where the socket accepts it, and asks the
# remote host what its chat is doing.
#
# Which chat matters is settled exactly rather than guessed. The surface id travels into the remote
# shell's environment when the connection opens, so the remote host can name the pty that belongs to
# this surface, the tmux client on it, and the conversation that client is looking at. Matching on
# connection ports instead would attribute the wrong chat whenever a shell owns more than one.
set -u

HOST="${1:-}"
INTERVAL="${2:-3}"
[ -n "$HOST" ] || { echo "usage: ${0##*/} <remote-host> [interval-seconds]" >&2; exit 2; }

CLI="${CMUX_BUNDLED_CLI_PATH:-/Applications/cmux.app/Contents/Resources/bin/cmux}"
[ -x "$CLI" ] || { echo "cmux cli not found at $CLI" >&2; exit 3; }
[ -n "${CMUX_SURFACE_ID:-}" ] || { echo "run this inside a cmux terminal" >&2; exit 4; }

# What the remote chat on that client is: its conversation id and what it published about itself.
remote_state() {
    ssh -o BatchMode=yes -o ConnectTimeout=8 "$HOST" "SURFACE='$CMUX_SURFACE_ID' bash -s" <<'REMOTE'
set -u
# The tmux client on the pty belonging to this ssh connection is showing one session, and the agent
# registry says which conversation that session holds.
# The pty belonging to this surface, named by the id its shell carries.
tty=""
for cand in $(ls /dev/pts 2>/dev/null); do
    for pid in $(ps -o pid= -t "pts/$cand" 2>/dev/null); do
        mine=$(cat /proc/$pid/environ 2>/dev/null | tr '\0' '\n' | sed -n 's/^CMUX_SURFACE_ID=//p')
        [ "$mine" = "$SURFACE" ] && [ -n "$mine" ] && tty="/dev/pts/$cand"
    done
    [ -n "$tty" ] && break
done
[ -n "$tty" ] || exit 0
session=$(tmux list-clients -F '#{client_tty} #{client_session}' 2>/dev/null | awk -v t="$tty" '$1 == t {print $2; exit}')
[ -n "$session" ] || exit 0
for f in "$HOME"/.claude/sessions/*.json; do
    [ -f "$f" ] || continue
    read -r sid tm pub_status pid < <(jq -r '[.sessionId, (.tmux // "-"), (.status // "-"), .pid] | @tsv' "$f" 2>/dev/null)
    [ "${tm%%:*}" = "$session" ] || continue
    kill -0 "$pid" 2>/dev/null || continue
    printf '%s\t%s\n' "$sid" "$pub_status"
    exit 0
done
REMOTE
}

# The process cmux can watch on this machine for this chat: the ssh that carries it.
note_pid() {
    local sid="$1" store="$HOME/.cmuxterm/claude-hook-sessions.json" ssh_pid
    [ -f "$store" ] || return 0
    ssh_pid=$(pgrep -P $PPID -x ssh 2>/dev/null | head -1)
    [ -n "$ssh_pid" ] || return 0
    /usr/bin/python3 - "$store" "$sid" "$ssh_pid" <<'PATCH'
import json, sys
store, sid, pid = sys.argv[1], sys.argv[2], int(sys.argv[3])
try:
    data = json.load(open(store))
except Exception:
    sys.exit(0)
entry = data.get("sessions", {}).get(sid)
if entry is None or entry.get("pid") == pid:
    sys.exit(0)
entry["pid"] = pid
json.dump(data, open(store, "w"), indent=1)
PATCH
}

# `busy` and `shell` are a turn or a command in flight; anything else is waiting on you.
event_for() {
    case "$1" in
        busy | shell) printf 'prompt-submit' ;;
        *) printf 'stop' ;;
    esac
}

last=""
while :; do
    if state=$(remote_state) && [ -n "$state" ]; then
        sid=${state%%$'\t'*}
        status=${state##*$'\t'}
        event=$(event_for "$status")
        if [ "$event" != "$last" ]; then
            # cmux identifies the agent by the parent of the hook that reported, and watches that
            # process to decide whether the chat is still working. A pipeline would make some
            # short-lived subshell the parent, which dies at once and reads as an agent that has
            # gone, so the payload arrives on a here-string and this loop is the parent.
            "$CLI" hooks claude "$event" >/dev/null 2>&1 <<<"$(printf '{"session_id":"%s","cwd":"%s"}' "$sid" "$PWD")"
            # The hook drives cmux's own lifecycle. A status entry is the documented way to put text
            # on a row, so both are set: whichever the sidebar draws for a remote surface, the row
            # says what the chat is doing.
            case "$event" in
                prompt-submit) "$CLI" set-status claude_code Running --icon bolt --color '#4c8dff' --priority 80 >/dev/null 2>&1 ;;
                *) "$CLI" clear-status claude_code >/dev/null 2>&1 ;;
            esac
            # cmux records a lifecycle per surface and checks the agent is alive before showing it
            # working. It learns that pid by being the agent's parent, which no remote chat can
            # offer, so the ssh holding this connection stands in: it lives exactly as long as the
            # chat is reachable from here, which is the same question the check is asking.
            note_pid "$sid"
            last="$event"
        fi
    fi
    sleep "$INTERVAL"
done
