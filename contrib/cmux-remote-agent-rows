#!/bin/bash
# Give every remote chat's cmux row its state, from one process on this machine.
#
#   cmux-remote-agent-rows <remote-host> [interval-seconds]
#
# The companion `cmux-remote-agent-status` reports for the one terminal it lives in, because cmux takes
# its own agent lifecycle only from a process it can trace into that terminal. Row text has no such
# rule: `set-status` names the workspace it applies to, so a single process can speak for every terminal
# open to that host, including the ones that were already open before it started.
#
# Pairing a remote chat with the row that shows it goes through the title. A chat publishes its own
# title as the terminal's title, cmux keeps that as the surface's title, and the host knows which chat
# each of its attached clients is looking at. Matching on the connection instead holds only for a direct
# ssh: a `ProxyCommand` relay makes the port the host sees belong to the relay, and no process here owns
# it. A title travels end to end whatever carries the connection.
#
#   chat on the far side ─ its title ─ surface title here ─ workspace ─ row
#
# Nothing needs to be installed on the remote host, and nothing needs to be arranged per terminal.
set -u

HOST="${1:-}"
INTERVAL="${2:-3}"
[ -n "$HOST" ] || { echo "usage: ${0##*/} <remote-host> [interval-seconds]" >&2; exit 2; }

CLI="${CMUX_BUNDLED_CLI_PATH:-/Applications/cmux.app/Contents/Resources/bin/cmux}"
[ -x "$CLI" ] || { echo "cmux cli not found at $CLI" >&2; exit 3; }

CONTROL="${TMPDIR:-/tmp}/cmux-remote-rows-$$"
export CMUX_QUIET=1
export CMUX_SOCKET_PATH="${CMUX_SOCKET_PATH:-$HOME/.local/state/cmux/cmux.sock}"

# The socket accepts a caller carrying a capability token. A process cmux started has one in its
# environment; this one may have been started by anything, so it borrows a token from a terminal cmux is
# running. Tokens change when cmux restarts, which is why this is asked again on every pass.
borrow_token() {
    local pid token
    for pid in $(pgrep -x fish 2>/dev/null; pgrep -x zsh 2>/dev/null; pgrep -x bash 2>/dev/null); do
        token=$(ps eww -p "$pid" 2>/dev/null | tr ' ' '\n' | sed -n 's/^CMUX_SOCKET_CAPABILITY=//p' | head -1)
        [ -n "$token" ] && { export CMUX_SOCKET_CAPABILITY="$token"; return 0; }
    done
    return 1
}

cmux_up() { [ -S "$CMUX_SOCKET_PATH" ]; }

# One line per chat a client on the far side is looking at: what it published, whether it is waiting on
# an answer, its directory, and its own title.
# `ServerAlive` is the leash. A relayed connection can stop carrying traffic while the socket stays
# open, and a read with nothing bounding it waits forever: the loop stops polling, the last state it
# wrote stays on the row, and the row goes on claiming something that stopped being true.
remote_rows() {
    ssh -o BatchMode=yes -o ConnectTimeout=8 \
        -o ServerAliveInterval=4 -o ServerAliveCountMax=2 \
        -o ControlMaster=auto -o ControlPath="$CONTROL" -o ControlPersist=30 \
        "$HOST" bash -s <<'REMOTE'
set -u
tmux list-clients -F '#{client_tty} #{client_session}' 2>/dev/null | while read -r tty session; do
    for f in "$HOME"/.claude/sessions/*.json; do
        [ -f "$f" ] || continue
        read -r sid tm published pid dir changed < <(jq -r '[.sessionId, (.tmux // "-"), (.status // "-"), .pid, (.cwd // "-"), (((.statusUpdatedAt // 0) / 1000) | floor)] | @tsv' "$f" 2>/dev/null)
        [ "${tm%%:*}" = "$session" ] || continue
        kill -0 "$pid" 2>/dev/null || continue

        # A chat stopped on a permission or a question is still inside its turn, so the published status
        # reads as working. The notification hook records that state in a file instead.
        waiting=no
        marker="${XDG_CACHE_HOME:-$HOME/.cache}/agent-tmux/waiting/$sid"
        if [ -f "$marker" ]; then
            # A marker older than the chat's last status change describes a moment that has passed: the
            # chat moved on without the hook that clears it ever running, so the file goes.
            mtime=$(stat -c %Y "$marker" 2>/dev/null || stat -f %m "$marker" 2>/dev/null)
            if [ -n "$mtime" ] && [ "$mtime" -lt "$changed" ]; then
                rm -f "$marker" 2>/dev/null
            else
                waiting=yes
            fi
        fi

        # The name the chat gave itself, which is also what it publishes as the terminal's title. A
        # transcript reaches tens of megabytes, so only its tail is read.
        key=$(printf '%s' "$dir" | sed 's|/|-|g')
        title=$(tail -c 262144 "$HOME/.claude/projects/$key/$sid.jsonl" 2>/dev/null |
            grep -o '"aiTitle":"[^"]*"' | tail -1 | sed 's/^"aiTitle":"//; s/"$//')

        printf '%s\t%s\t%s\t%s\n' "$published" "$waiting" "$dir" "$title"
        break
    done
done
REMOTE
}

# Every terminal surface cmux is showing, as `workspace<TAB>title`.
surface_titles() {
    local id
    for id in $("$CLI" list-workspaces --json --id-format uuids 2>/dev/null |
        grep -o '"id"[^"]*"[0-9A-Fa-f-]\{36\}"' | grep -o '[0-9A-Fa-f-]\{36\}' | sort -u); do
        "$CLI" list-pane-surfaces --workspace "$id" --json 2>/dev/null |
            grep -o '"title"[^"]*"[^"]*"' | sed 's/^"title"[^"]*"//; s/"$//' |
            while IFS= read -r title; do
                [ -n "$title" ] && printf '%s\t%s\n' "$id" "$title"
            done
    done
}

# The row showing a chat: the surface whose title ends with the chat's own. Two surfaces answering to
# one title name no row in particular, so neither is written.
workspace_for_title() {
    local want="$1" matches
    [ -n "$want" ] || return 1
    matches=$(printf '%s\n' "$TITLES" | awk -F'\t' -v want="$want" '
        length($2) >= length(want) && substr($2, length($2) - length(want) + 1) == want { print $1 }' | sort -u)
    [ "$(printf '%s\n' "$matches" | grep -c .)" = "1" ] || return 1
    printf '%s' "$matches"
}

# `busy` and `shell` are a turn or a command running; a chat waiting on an answer outranks both, since
# that happens inside a turn and the published status cannot show it.
phase_for() {
    if [ "$2" = yes ]; then
        printf 'asking'
    else
        case "$1" in
            busy | shell) printf 'working' ;;
            *) printf 'waiting' ;;
        esac
    fi
}

# The wording, icon and colour of the first two are cmux's own, so a chat on another machine reads the
# same as one on this one. cmux draws nothing for an idle agent, so the third is this one's own choice: a
# row that says nothing leaves you wondering whether the chat finished or the reporting stopped.
set_row() {
    local ws="$1" phase="$2"
    case "$phase" in
        working) "$CLI" set-status remote_chat Running --icon bolt.fill --color '#4C8DFF' --priority 80 --workspace "$ws" >/dev/null 2>&1 ;;
        asking) "$CLI" set-status remote_chat "Needs input" --icon bell.fill --color '#4C8DFF' --priority 90 --workspace "$ws" >/dev/null 2>&1 ;;
        *) "$CLI" set-status remote_chat Idle --icon moon --color '#8e8e93' --priority 40 --workspace "$ws" >/dev/null 2>&1 ;;
    esac
}

clear_row() { "$CLI" clear-status remote_chat --workspace "$1" >/dev/null 2>&1; }

# cmux writes its own agent line, under its own key, for a surface that has one of its agent sessions
# bound. For a chat on another machine that line comes from something reporting a lifecycle, and it
# holds whatever it was last told: a reporter that stops or hangs leaves it saying `Running` for as long
# as cmux keeps the binding. This has the far side's own answer every few seconds, so for a chat it can
# see it takes the row over and drops the other line rather than deferring to it.
drop_cmux_line() { "$CLI" clear-status claude_code --workspace "$1" >/dev/null 2>&1; }

# A line written by an earlier run outlives that run, and a row this can no longer pair keeps showing
# whatever it last said, which ages into a lie. Every row starts clear and is rebuilt from what the host
# reports.
sweep_rows() {
    local id
    for id in $("$CLI" list-workspaces --json --id-format uuids 2>/dev/null |
        grep -o '"id"[^"]*"[0-9A-Fa-f-]\{36\}"' | grep -o '[0-9A-Fa-f-]\{36\}' | sort -u); do
        clear_row "$id"
    done
}

shown=""
swept=no
TITLES=""

finish() {
    local pair
    for pair in $(printf '%s' "$shown" | tr ';' ' '); do
        clear_row "${pair%%=*}"
    done
    ssh -o ControlPath="$CONTROL" -O exit "$HOST" 2>/dev/null
    exit 0
}
trap finish EXIT INT TERM

while :; do
    if cmux_up && borrow_token; then
        if [ "$swept" = no ]; then
            sweep_rows
            swept=yes
        fi
        rows=$(remote_rows 2>/dev/null)
        TITLES=$(surface_titles)
        seen=""
        while IFS=$'\t' read -r published waiting dir title; do
            [ -n "${title:-}" ] || continue
            ws=$(workspace_for_title "$title") || continue
            drop_cmux_line "$ws"
            phase=$(phase_for "$published" "${waiting:-no}")
            # Written every poll rather than on a change. cmux rebuilds a row's snapshot as you select
            # and move around the sidebar, and an entry can go with it; last write per key wins, so
            # repeating costs one socket call and the row comes back within an interval.
            set_row "$ws" "$phase"
            case "$shown" in
                *"$ws=$phase;"*) ;;
                *) printf '%s %s %s %s\n' "$(date +%H:%M:%S)" "${ws%%-*}" "$phase" "$title" ;;
            esac
            seen="$seen$ws=$phase;"
        done <<<"$rows"

        # A row that stopped reporting is a chat detached or ended, and leaving its last state up would
        # keep saying something that has stopped being true.
        for pair in $(printf '%s' "$shown" | tr ';' ' '); do
            ws="${pair%%=*}"
            case "$seen" in
                *"$ws="*) ;;
                *) clear_row "$ws" ;;
            esac
        done
        shown="$seen"
    fi
    sleep "$INTERVAL"
done
